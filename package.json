{
  "name": "3d-printer-stream",
  "version": "1.0.0",
  "description": "Feral Creative 3D Printer Live Stream with Status Overlay",
  "type": "module",
  "scripts": {
    "dev": "npx vite --host",
    "sass": "sass --no-source-map styles/scss/main.scss styles/css/main.css",
    "sass:min": "sass --no-source-map --style=compressed styles/scss/main.scss styles/css/main.min.css",
    "sass:watch": "sass --watch --no-source-map styles/scss/main.scss:styles/css/main.css",
    "sass:watch:min": "sass --watch --no-source-map --style=compressed styles/scss/main.scss:styles/css/main.min.css",
    "build:css": "npm run sass && npm run sass:min",
    "build": "npm run build:css && vite build",
    "preview": "npx vite preview",
    "test:models": "node --test utils/project-gallery.test.js utils/model-management.test.js utils/model-admin.test.js",
    "proxy": "node server.js",
    "start": "node utils/dev.js"
  },
  "keywords": [
    "flashforge",
    "3d-printer",
    "stream"
  ],
  "author": "Ziad",
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.22.1",
    "form-data": "^4.0.5",
    "multer": "^2.0.2",
    "node-stl": "^0.7.3",
    "online-3d-viewer": "^0.18.0"
  },
  "devDependencies": {
    "sass": "^1.105.2",
    "vite": "^5.0.0"
  }
}
