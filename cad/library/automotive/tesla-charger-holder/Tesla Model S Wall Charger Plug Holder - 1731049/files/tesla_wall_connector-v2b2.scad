//Measured dims are 11x6.4 with 4.5mm depth
module charger_notch(){
    translate([0,-16.5,0])
        cube([9.5, 4.5, 5.0], center=true);
            round(10,10);
}

module screw_hole(){
    translate([0,0,-4]) {
        cylinder(r=2.5, h = height*3, $fn=40);
        translate([0,0,12]) 
            cylinder(r=4.5, 30, $fn=40);
    }
}
module screw_hole2(){
    rotate([30,0,0])
    translate([0,0,-12]) {
        cylinder(r=2.5, h = height*.6, $fn=40);
        translate([0,0,15]) 
            cylinder(r=4.5, 10, $fn=40);
    }
}
width = 35;
height = 65;
holeheight = 68;
depth = 35;

tilt = 50;
difference() {
    union() {
        $fn=50;
        translate([0,0,-2]) 
            minkowski() {
                cube([width, height, 1]);
                cylinder(r=8,h=1);
            }
 
        difference() {
        $fn=50;
            
            minkowski() {
                cube([width, height, depth]);
                cylinder(r=8,h=1);
            }
            /*translate([width/2-4, height-8, depth])
                linear_extrude(3)
                text("T", font = "Monaco", size = 10);*/
            
            translate([width/2,holeheight,0])   
                rotate([tilt,0,0])
                    translate([0, 0,depth*.32])  
                        scale(1.1)
                            charger_end(depth * 4);
        }
     
    }
    
    translate([width/2,holeheight*.19,0])
        screw_hole();    
    translate([width/2,holeheight*.22+47,0])
        screw_hole2();   
}

translate([width/2,holeheight/2,sin(tilt)*depth])   
    rotate([tilt,0,0])
        translate([0,0,3]) 
            scale(1)
                charger_notch();

