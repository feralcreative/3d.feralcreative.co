# Generated output — reproducible from source, never committed
renders/*
!renders/.gitkeep

# stl/ — finished parts are committed, work in progress is not.
#
# A finished part carries no version in its name (see utils/finalize.sh), and
# that file is the deliverable: it is what gets printed and what gets sent to
# anyone. Every -vNN build beside it is scratch from an iteration that is over.
#
# Order matters here — the last matching pattern wins, and re-including only
# works because stl/ itself is never excluded, only its contents.
stl/*
!stl/.gitkeep
!stl/*.stl
stl/*-v[0-9][0-9]*.stl

# The one case the rule above cannot see: while a series is still moving,
# stl/<name>.stl is build.sh's copy of the newest -vNN, rewritten on every
# build. The re-include catches it by name and git happily commits it, so the
# repo would carry a fresh binary per draft. finalize.sh is what marks a series
# as worth committing; until it has been run, list the name here.
stl/screen-fence-test-rail.stl
stl/screen-fence-clip-coupon.stl
stl/screen-fence-twin-coupon.stl
stl/screen-fence-fit-pair.stl
stl/cat-gap-wedge.stl
stl/cat-gap-wedge-coupon.stl
stl/zr-monogram-stamp-2026.stl
stl/sofa-monitor-stand.stl
stl/sofa-monitor-stand-coupon.stl
stl/sofa-monitor-stand-base.stl
stl/sofa-monitor-stand-base-coupon.stl
stl/sofa-monitor-stand-base-slice.stl
stl/doorbell-wire-channel.stl
stl/doorbell-wire-channel-upper.stl
stl/doorbell-wire-channel-cap.stl
